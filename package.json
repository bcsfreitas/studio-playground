{
  "name": "studio-home",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && npm run patch:nuxt",
    "patch:nuxt": "cd node_modules/nuxt && (patch -p1 -N --dry-run -s < ../../patches/nuxt+4.5.0.patch && patch -p1 -N < ../../patches/nuxt+4.5.0.patch) || true",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@nuxt/icon": "^2.3.1",
    "@nuxt/ui": "^4.10.0",
    "@storybook-vue/nuxt": "^9.1.0-29411911.f34c865",
    "nuxt": "^4.5.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.118",
    "@nuxtjs/storybook": "^9.1.0-29411911.f34c865",
    "@storybook/addon-a11y": "^10.0.8",
    "@storybook/addon-docs": "^10.0.8",
    "jsdoc-type-pratt-parser": "^4.8.0",
    "storybook": "^10.0.8"
  },
  "overrides": {
    "vite": "8.1.5"
  }
}
