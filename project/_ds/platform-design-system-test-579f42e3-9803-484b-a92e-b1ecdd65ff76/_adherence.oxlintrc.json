{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "ui_kits/studio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Figtree))/i]",
        "message": "Font not provided by the design system. Available: Inter, Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|name|size|ring|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, name, size, ring, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|variant|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, color, variant, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|secondary|neutral|success|warning|error|kids)$/]",
        "message": "<Badge> color must be one of 'primary' | 'secondary' | 'neutral' | 'success' | 'warning' | 'error' | 'kids'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:soft|solid|outline)$/]",
        "message": "<Badge> variant must be one of 'soft' | 'solid' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|variant|size|disabled|block|leadingIcon|trailingIcon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, color, variant, size, disabled, block, leadingIcon, trailingIcon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='color'] > Literal[value!=/^(?:primary|secondary|neutral|success|error)$/]",
        "message": "<Button> color must be one of 'primary' | 'secondary' | 'neutral' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|soft|ghost|link)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outline' | 'soft' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|header|footer|variant|hover|padding|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, header, footer, variant, hover, padding, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:flat|outline|soft|ghost)$/]",
        "message": "<Card> variant must be one of 'flat' | 'outline' | 'soft' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GameTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|tag|members|phase|onClick|style|key|ref|className|style|children)$/]",
        "message": "<GameTile> doesn't accept that prop. Declared props: image, name, tag, members, phase, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|avatar|time|source|postType|image|children|tags|likes|comments|liked|onLike|onComment|style|key|ref|className|style|children)$/]",
        "message": "<PostCard> doesn't accept that prop. Declared props: author, avatar, time, source, postType, image, children, tags, likes, comments, liked, onLike, onComment, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgramTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|description|tasksCount|status|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProgramTile> doesn't accept that prop. Declared props: image, name, description, tasksCount, status, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillToken'] > JSXAttribute > JSXIdentifier[name!=/^(?:domain|icon|level|size|style|key|ref|className|style|children)$/]",
        "message": "<SkillToken> doesn't accept that prop. Declared props: domain, icon, level, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SkillToken'] > JSXAttribute[name.name='domain'] > Literal[value!=/^(?:Art|Game Design|Engineering|Go to Market|Management & Production)$/]",
        "message": "<SkillToken> domain must be one of 'Art' | 'Game Design' | 'Engineering' | 'Go to Market' | 'Management & Production'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|project|projectImage|due|dueSoon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<TaskTile> doesn't accept that prop. Declared props: name, status, project, projectImage, due, dueSoon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TaskTile'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:New|In Progress|In Review|Need help|Feedback|Done)$/]",
        "message": "<TaskTile> status must be one of 'New' | 'In Progress' | 'In Review' | 'Need help' | 'Feedback' | 'Done'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
